  m_EditorClassIdentifier: Assembly-CSharp::ShipyardFacilityAdapter
  facility: {fileID: 423083138}
  recordJson: "{\"id\":1,\"sourceRow\":2,\"facilityId\":\"F01\",\"name\":\"1\uB3C4\uD06C\uC640
    900\uD1A4 \uACE8\uB9AC\uC557 \uD06C\uB808\uC778\",\"officialName\":\"1\uB3C4\uD06C\uC640
    900\uD1A4 \uACE8\uB9AC\uC557 \uD06C\uB808\uC778\",\"englishName\":\"No.1 Dock
    and the 900-ton Goliath Crane\",\"classification\":\"\uB3C4\uD06C\",\"type\":\"\uB4DC\uB77C\uC774
    \uB3C4\uD06C\",\"description\":\"\uBE14\uB85D\uC744 \uC313\uC544 \uC120\uCCB4\uB97C
    \uC644\uC131\uD558\uB294 \uC138\uACC4 \uCD5C\uB300\uAE09 \uB4DC\uB77C\uC774 \uB3C4\uD06C.
    100\uB9CC DWT\uAE09 \uC720\uC870\uC120\uC774\uB098 \uD3ED 120m\xB7\uB192\uC774
    130m \uD574\uC591\uD50C\uB79C\uD2B8\uB97C \uB3C4\uD06C \uC548\uC5D0\uC11C \uAC74\uC870\uD560
    \uC218 \uC788\uACE0, 900t \uACE8\uB9AC\uC557 \uD06C\uB808\uC778 \uC544\uB798\uC5D0\uC11C
    \uB300\uD615 \uBE14\uB85D \uD0D1\uC7AC\uAC00 \uC774\uB904\uC9C4\uB2E4.\",\"mainProcess\":\"\xB7
    \uBE14\uB85D \uD0D1\uC7AC(\uC120\uCCB4 \uC644\uC131)\\n\xB7 VLCC\xB7\uC218\uC5D0\uC988\uB9C9\uC2A4\xB7LNG\uC6B4\uBC18\uC120
    \uAC74\uC870\\n\xB7 \uB300\uD615 \uD574\uC591\uD50C\uB79C\uD2B8 \uB3C4\uD06C
    \uB0B4 \uAC74\uC870\\n\xB7 \uC9C4\uC218(\uB3C4\uD06C \uC8FC\uC218 \uD6C4 \uAC8C\uC774\uD2B8
    \uAC1C\uBC29)\",\"specifications\":\"\uAE38\uC774(m): 530\\n\uD3ED(m): 131\\n\uAE4A\uC774(m):
    14.5\\n\uCD5C\uB300\uAC74\uC870(DWT): 1,000,000\\n\uCD5C\uB300\uD50C\uB79C\uD2B8\uD3ED(m):
    120\\n\uCD5C\uB300\uD50C\uB79C\uD2B8\uB192\uC774(m): 130\",\"cranes\":\"\uAC20\uD2B8\uB9AC(\uACE8\uB9AC\uC557)
    900t \xD7 1\uAE30\\n\uC9D1 \uD06C\uB808\uC778 200t \xD7 1\uAE30\\n\uC9D1 \uD06C\uB808\uC778
    50t \xD7 3\uAE30\\n\uC8FC\uD589\uC2DD \uD0C0\uC6CC\uD06C\uB808\uC778 60t \xD7
    1\uAE30\\n\uD0C0\uC6CC\uD06C\uB808\uC778 60t \xD7 1\uAE30\\n\uC9D1 \uD06C\uB808\uC778
    50t \xD7 4\uAE30\",\"equipment\":\"\xB7 \uB3C4\uD06C \uAC8C\uC774\uD2B8(\uC218\uBB38)\",\"notes\":\"\xB7
    \uAE30\uB124\uC2A4\uBD81 \uB4F1\uC7AC \uC2DC\uC124\uB85C \uC18C\uAC1C\uB428.\\n\xB7
    \uACF5\uC2DD \uD398\uC774\uC9C0 \uBCF8\uBB38\uC740 '50~200t \uC9D1\uD06C\uB808\uC778
    6\uAE30'\uB85C \uC801\uACE0 \uD06C\uB808\uC778 \uD45C\uC5D0\uB294 \uC9D1\uD06C\uB808\uC778
    8\uAE30(200t 1\xB750t 7)\uB85C \uC801\uD600 \uC788\uC5B4 \uC218\uB7C9\uC774 \uC77C\uCE58\uD558\uC9C0
    \uC54A\uC74C.\\n\xB7 30\uB9CC\uD1A4\uAE09 \uC720\uC870\uC120 \uAE30\uC900 \uBE14\uB85D
    80\uC5EC \uAC1C(\uAC1C\uB2F9 \uC57D 780t)\uB97C \uACE8\uB9AC\uC557 \uD06C\uB808\uC778\uC73C\uB85C
    \uD0D1\uC7AC(\uACF5\uC2DD Build a Ship).\",\"confidence\":\"A\",\"source\":\"\uD55C\uD654\uC624\uC158
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C
    > Facilities\\nHanwha Ocean official site > Geoje shipyard > Facilities (English)\\nLloyd's
    Register New Construction Guide - Hanwha Ocean Co Ltd (2026-06-08 \uAC31\uC2E0)\\n\uD55C\uD654\uC624\uC158
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C
    > Build a Ship\\n\uD5E4\uB7F4\uB4DC\uACBD\uC81C \uB974\uD3EC - \uD55C\uD654\uC624\uC158
    \uAC70\uC81C \uC0AC\uC5C5\uC7A5 (2026.03)\",\"imageFile\":\"01_dock1.png\",\"dimensionBasis\":\"WORKBOOK_PUBLIC_DATA\",\"locationBasis\":\"CURRENT_LAYOUT_RECONSTRUCTION\",\"lengthM\":530.0,\"widthM\":131.0,\"depthM\":14.5,\"areaM2\":null,\"quayLengthM\":null,\"function_value_status\":null,\"function_source\":null,\"dimension_value_status\":\"OFFICIAL\",\"dimension_status_note\":null,\"function_capabilities\":null,\"value_evidence\":[{\"key\":\"dock_dimension\",\"label\":\"DOCK
    DIMENSION\",\"value\":\"530 \xD7 131 \xD7 14.5\",\"unit\":\"m\",\"value_status\":\"OFFICIAL\",\"source\":\"https://www.hanwhaocean.com/en/whoweare/ig/facilities/\",\"verified_date\":\"2026-10-20\",\"note\":null,\"status_detail\":null}]}"
