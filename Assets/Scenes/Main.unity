  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CraneAssetMetadata
  craneType: "\uC9D1 \uD06C\uB808\uC778"
  capacityText: 50 t
  facilityId: F01
  source: "\uD55C\uD654\uC624\uC158 \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5
    \uC18C\uAC1C > Facilities"
  sourceStatus: CONFLICTING_TABLE_VS_TEXT
  modelBasis: ESTIMATED_FROM_PUBLIC_REFERENCES
  notes: "\uC218\uB7C9: 3\n\xB7 \uAE30\uB124\uC2A4\uBD81 \uB4F1\uC7AC \uC2DC\uC124\uB85C
    \uC18C\uAC1C\uB428.\n\xB7 \uACF5\uC2DD \uD398\uC774\uC9C0 \uBCF8\uBB38\uC740
    '50~200t \uC9D1\uD06C\uB808\uC778 6\uAE30'\uB85C \uC801\uACE0 \uD06C\uB808\uC778
    \uD45C\uC5D0\uB294 \uC9D1\uD06C\uB808\uC778 8\uAE30(200t 1\xB750t 7)\uB85C \uC801\uD600
    \uC788\uC5B4 \uC218\uB7C9\uC774 \uC77C\uCE58\uD558\uC9C0 \uC54A\uC74C.\n\xB7
    30\uB9CC\uD1A4\uAE09 \uC720\uC870\uC120 \uAE30\uC900 \uBE14\uB85D 80\uC5EC \uAC1C(\uAC1C\uB2F9
    \uC57D 780t)\uB97C \uACE8\uB9AC\uC557 \uD06C\uB808\uC778\uC73C\uB85C \uD0D1\uC7AC(\uACF5\uC2DD
    Build a Ship)."
  capacityTon: 50
  hasCapacity: 1
  isPublicValue: 1
  isEstimated: 1
  sourceRow: 4
