  facility: {fileID: 148443872}
  recordJson: "{\"id\":12,\"sourceRow\":13,\"facilityId\":\"F12\",\"name\":\"\uC870\uB9BD
    1\uACF5\uC7A5 \uBC0F \uC870\uB9BD 3\uACF5\uC7A5\",\"officialName\":\"\uC870\uB9BD
    1\uACF5\uC7A5 \uBC0F \uC870\uB9BD 3\uACF5\uC7A5\",\"englishName\":\"Assembly
    Plant 1 and Assembly Plant 3\",\"classification\":\"\uC870\uB9BD\",\"type\":\"\uC0DD\uC0B0\uACF5\uC7A5\",\"description\":\"\uBC30\uC758
    \uBAB8\uD1B5\uC778 \uC911\uC559\uBD80 \uC120\uCCB4 \uBE14\uB85D\uC744 \uB9CC\uB4DC\uB294
    \uACF5\uC7A5. \uD070 \uCCA0\uD310\uC744 \uC787\uB294 \uC790\uB3D9\uD310\uC811\uC7A5\uCE58\uC640
    \uB860\uC9C0 \uC790\uB3D9\uCDE8\uBD80\xB7\uC6A9\uC811\uC7A5\uCE58, \uC218\uC2ED
    \uB300\uC758 \uC6A9\uC811\uB85C\uBD07\uACFC \uC11C\uBE0C\uBA38\uC9C0\uB4DC \uC544\uD06C
    \uC6A9\uC811\uAE30\uB97C \uAC16\uCDC4\uB2E4.\",\"mainProcess\":\"\xB7 \uC911\uC559\uBD80
    \uC120\uCCB4 \uBE14\uB85D \uC870\uB9BD\\n\xB7 \uD310\uACC4 \uC790\uB3D9 \uC811\uD569\\n\xB7
    \uB860\uC9C0 \uCDE8\uBD80\xB7\uC6A9\uC811\",\"specifications\":null,\"cranes\":null,\"equipment\":\"\xB7
    \uC790\uB3D9\uD310\uC811\uC7A5\uCE58\\n\xB7 \uB860\uC9C0 \uC790\uB3D9\uCDE8\uBD80\xB7\uC6A9\uC811\uC7A5\uCE58\\n\xB7
    \uC790\uB3D9 \uC6A9\uC811\uB85C\uBD07 \uC218\uC2ED \uB300\\n\xB7 \uC11C\uBE0C\uBA38\uC9C0\uB4DC
    \uC790\uB3D9 \uC6A9\uC811\uAE30\",\"notes\":\"\xB7 '\uC591\uBA74 Slit \uACF5\uBC95'(\uC885\uBC29\uD5A5
    \uACE8\uC7AC\uC640 \uD6A1\uBC29\uD5A5 \uACE8\uC7AC\uB97C \uB07C\uC6CC \uB9DE\uCDA4)\uC73C\uB85C
    \uC18C\uAC1C\uB428.\\n\xB7 \uACF5\uC2DD \uD398\uC774\uC9C0\uB294 \uC774 \uB450
    \uACF5\uC7A5\uC744 '\uC57C\uB4DC\uC5D0\uC11C \uAC00\uC7A5 \uD070 \uACF5\uC7A5'\uC774\uB77C
    \uD558\uACE0, \uD574\uC591\uC81C\uC791 3\uACF5\uC7A5\uC740 '\uB2E8\uC77C \uACF5\uC7A5\uC73C\uB85C\uB294
    \uAC00\uC7A5 \uD070 \uACF5\uC7A5'\uC774\uB77C \uD568.\\n\xB7 \uC870\uB9BD\uACF5\uC7A5
    4\uACF3\uC5D0\uC11C \uD558\uB8E8 20~30\uC5EC \uAC1C\uC758 300t\uAE09 \uBE14\uB85D
    \uC0DD\uC0B0(Build a Ship).\",\"confidence\":\"A\",\"source\":\"\uD55C\uD654\uC624\uC158
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C
    > Facilities\\nHanwha Ocean official site > Geoje shipyard > Facilities (English)\\n\uD55C\uD654\uC624\uC158
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C
    > Build a Ship\",\"imageFile\":\"12_assembly_1_3.png\",\"dimensionBasis\":\"UNKNOWN\",\"locationBasis\":\"CURRENT_LAYOUT_RECONSTRUCTION\",\"lengthM\":null,\"widthM\":null,\"depthM\":null,\"areaM2\":null,\"quayLengthM\":null}"
