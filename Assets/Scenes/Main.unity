  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShipyardFacilityAdapter
  facility: {fileID: 908993832}
  recordJson: "{\"id\":21,\"sourceRow\":22,\"facilityId\":\"F21\",\"name\":\"\uD574\uC591\uD50C\uB79C\uD2B8
    \uC625\uC678 \uC870\uB9BD\uC7A5\",\"officialName\":\"\uD574\uC591\uD50C\uB79C\uD2B8
    \uC625\uC678 \uC870\uB9BD\uC7A5\",\"englishName\":\"Offshore Plant Outside Assembly
    Site\",\"classification\":\"\uD574\uC591\uC81C\uC791\",\"type\":\"\uC625\uC678
    \uC870\uB9BD\uC7A5\",\"description\":\"\uACF5\uC7A5\uC5D0\uC11C \uB9CC\uB4E0
    \uBE14\uB85D\uC744 \uC625\uC678\uC5D0\uC11C \uC774\uC5B4 \uCD08\uB300\uD615 \uBE14\uB85D\uACFC
    \uC644\uC81C\uD488\uC73C\uB85C \uB9CC\uB4DC\uB294 \uACF3. \uC644\uC131\uD488\uC740
    \uB808\uC77C\uC744 \uB530\uB77C \uC548\uBCBD\uC73C\uB85C \uBC00\uC5B4 \uBC14\uC9C0\uC120\uC5D0
    \uC2E3\uB294\uB2E4. \uC6B0\uCC9C \uC791\uC5C5\uC6A9 \uB300\uD615 \uC178\uD130\uAC00
    \uC788\uB2E4.\",\"mainProcess\":\"\xB7 \uCD08\uB300\uD615 \uBE14\uB85D \uC5F0\uACB0\xB7\uC870\uB9BD\\n\xB7
    \uB370\uD06C \uD78C\uC9C0 \uD134\uC624\uBC84(400t \uC774\uD558\uB294 \uD06C\uB864\uB7EC
    \uD06C\uB808\uC778)\\n\xB7 \uB808\uC77C \uC2A4\uD0A4\uB4DC \uC774\uB3D9\xB7\uBC14\uC9C0\uC120
    \uC120\uC801\",\"specifications\":null,\"cranes\":\"\uD06C\uB864\uB7EC \uD06C\uB808\uC778\",\"equipment\":\"\xB7
    \uC2A4\uD0A4\uB4DC \uB808\uC77C\\n\xB7 \uB300\uD615 \uC178\uD130\",\"notes\":\"\xB7
    \uC644\uC81C\uD488 \uD558\uC911\uC744 \uAD6D\uBB38 \uD398\uC774\uC9C0\uB294 '\uC218\uB9CC
    \uD1A4', \uC601\uBB38 \uD398\uC774\uC9C0\uB294 'thousands of tons'\uB85C \uC801\uC5B4
    \uB2E4\uB984.\\n\xB7 \uB370\uD06C \uD134\uC624\uBC84: 400t \uC774\uD558 \uD06C\uB864\uB7EC
    \uD06C\uB808\uC778, \uCD08\uACFC \uC2DC \uACE8\uB9AC\uC557 \uD06C\uB808\uC778
    \uC0AC\uC6A9(Build a Plant).\",\"confidence\":\"A\",\"source\":\"\uD55C\uD654\uC624\uC158
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C
    > Facilities\\nHanwha Ocean official site > Geoje shipyard > Facilities (English)\\n\uD55C\uD654\uC624\uC158
