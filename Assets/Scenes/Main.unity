  facility: {fileID: 1764884579}
  recordJson: "{\"id\":2,\"sourceRow\":3,\"facilityId\":\"F02\",\"name\":\"2\uB3C4\uD06C\uC640
    900\uD1A4 \uACE8\uB9AC\uC557 \uD06C\uB808\uC778\",\"officialName\":\"2\uB3C4\uD06C\uC640
    900\uD1A4 \uACE8\uB9AC\uC557 \uD06C\uB808\uC778\",\"englishName\":\"No.2 Dock
    and the 900-ton Goliath Crane\",\"classification\":\"\uB3C4\uD06C\",\"type\":\"\uB4DC\uB77C\uC774
    \uB3C4\uD06C\",\"description\":\"1\uB3C4\uD06C\uBCF4\uB2E4 \uD3ED\uC774 \uC881\uACE0
    \uAE38\uC774\uAC00 \uAE34 \uB4DC\uB77C\uC774 \uB3C4\uD06C. \uCD08\uB300\uD615
    \uCEE8\uD14C\uC774\uB108\uC120, \uC790\uB3D9\uCC28\uC6B4\uBC18\uC120, \uC815\uC720\uC6B4\uBC18\uC120
    \uAC74\uC870\uAC00 \uC8FC\uB825\uC774\uBA70 \uD3ED 80m \uD50C\uB79C\uD2B8\uAE4C\uC9C0
    \uC218\uC6A9\uD55C\uB2E4.\",\"mainProcess\":\"\xB7 \uBE14\uB85D \uD0D1\uC7AC\\n\xB7
    \uCD08\uB300\uD615 \uCEE8\uD14C\uC774\uB108\uC120\xB7\uC790\uB3D9\uCC28\uC6B4\uBC18\uC120\xB7\uC815\uC720\uC6B4\uBC18\uC120
    \uAC74\uC870\",\"specifications\":\"\uAE38\uC774(m): 540\\n\uD3ED(m): 81\\n\uAE4A\uC774(m):
    14.5\\n\uCD5C\uB300\uAC74\uC870(DWT): 1,000,000\\n\uCD5C\uB300\uD50C\uB79C\uD2B8\uD3ED(m):
    80\",\"cranes\":\"\uAC20\uD2B8\uB9AC(\uACE8\uB9AC\uC557) 900t \xD7 1\uAE30\\n\uD0C0\uC6CC\uD06C\uB808\uC778
    50t \xD7 3\uAE30\",\"equipment\":\"\xB7 \uB3C4\uD06C \uAC8C\uC774\uD2B8(\uC218\uBB38)\",\"notes\":\"\xB7
    2009\uB144 2\uC6D4 \uD574\uC0C1\uD06C\uB808\uC778 2\uB300\uB97C \uBCD1\uB82C\uB85C
    \uC368\uC11C 900t \uACE8\uB9AC\uC557 \uD06C\uB808\uC778(\uC790\uCCB4\uC911\uB7C9
    \uC57D 5,500t)\uC744 \uD55C \uBC88\uC5D0 \uC124\uCE58\uD588\uACE0, \uAC19\uC740
    \uC2DC\uAE30 \uB3C4\uD06C \uAE38\uC774\uB97C 540m\uB85C \uB298\uB838\uB2E4\uB294
    \uBCF4\uB3C4\uAC00 \uC788\uC74C.\",\"confidence\":\"A\",\"source\":\"\uD55C\uD654\uC624\uC158
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C
    > Facilities\\nHanwha Ocean official site > Geoje shipyard > Facilities (English)\\nLloyd's
    Register New Construction Guide - Hanwha Ocean Co Ltd (2026-06-08 \uAC31\uC2E0)\\n\uB274\uC2A4\uC640\uC774\uC5B4
    - \uB300\uC6B0\uC870\uC120\uD574\uC591 900\uD1A4 \uACE8\uB9AC\uC557 \uD06C\uB808\uC778
    \uC6D0\uD0C0\uC784 \uC138\uD305 (2009.03)\",\"imageFile\":\"02_dock2.png\",\"dimensionBasis\":\"WORKBOOK_PUBLIC_DATA\",\"locationBasis\":\"CURRENT_LAYOUT_RECONSTRUCTION\",\"lengthM\":540.0,\"widthM\":81.0,\"depthM\":14.5,\"areaM2\":null,\"quayLengthM\":null,\"function_value_status\":null,\"function_source\":null,\"dimension_value_status\":\"OFFICIAL\",\"dimension_status_note\":null,\"function_capabilities\":null,\"value_evidence\":[{\"key\":\"dock_dimension\",\"label\":\"DOCK
    DIMENSION\",\"value\":\"540 \xD7 81 \xD7 14.5\",\"unit\":\"m\",\"value_status\":\"OFFICIAL\",\"source\":\"https://www.hanwhaocean.com/en/whoweare/ig/facilities/\",\"verified_date\":\"2026-10-20\",\"note\":null,\"status_detail\":null}]}"
