--- !u!114 &1806918483
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1806918480}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25e49152d0adaf049a78ba0df63caef4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CraneAssetMetadata
  craneType: "\uAC20\uD2B8\uB9AC(\uACE8\uB9AC\uC557)"
  capacityText: 900 t
  facilityId: F01
  source: "\uD55C\uD654\uC624\uC158 \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5
    \uC18C\uAC1C > Facilities"
  sourceStatus: WORKBOOK_PUBLIC_DATA
  modelBasis: ESTIMATED_FROM_PUBLIC_REFERENCES
  notes: "\uC218\uB7C9: 1\n\xB7 \uAE30\uB124\uC2A4\uBD81 \uB4F1\uC7AC \uC2DC\uC124\uB85C
    \uC18C\uAC1C\uB428.\n\xB7 \uACF5\uC2DD \uD398\uC774\uC9C0 \uBCF8\uBB38\uC740
    '50~200t \uC9D1\uD06C\uB808\uC778 6\uAE30'\uB85C \uC801\uACE0 \uD06C\uB808\uC778
    \uD45C\uC5D0\uB294 \uC9D1\uD06C\uB808\uC778 8\uAE30(200t 1\xB750t 7)\uB85C \uC801\uD600
    \uC788\uC5B4 \uC218\uB7C9\uC774 \uC77C\uCE58\uD558\uC9C0 \uC54A\uC74C.\n\xB7
    30\uB9CC\uD1A4\uAE09 \uC720\uC870\uC120 \uAE30\uC900 \uBE14\uB85D 80\uC5EC \uAC1C(\uAC1C\uB2F9
    \uC57D 780t)\uB97C \uACE8\uB9AC\uC557 \uD06C\uB808\uC778\uC73C\uB85C \uD0D1\uC7AC(\uACF5\uC2DD
    Build a Ship).\n\uACE8\uB9AC\uC557 \uD06C\uB808\uC778 \uBCF4\uC720: 4\uAE30 (\uC5B8\uB860
    \uBCF4\uB3C4 \uAE30\uC900)\n\uACE8\uB9AC\uC557 \uC815\uACA9\uD558\uC911(t): 900\n\uACE8\uB9AC\uC557
    \uCD5C\uB300 \uAD8C\uC0C1\uB192\uC774(m): 78\n\uACE8\uB9AC\uC557 \uC790\uCCB4\uC911\uB7C9(t):
    5500\n\uACE8\uB9AC\uC557 \uBE44\uACE0: \uBCF4\uC720\uB300\uC218 4\uAE30\uB294
    \uC5B8\uB860 \uBCF4\uB3C4 \uAE30\uC900. \uACF5\uC2DD \uC2DC\uC124 \uD398\uC774\uC9C0\uC5D0\uB294
    1\uB3C4\uD06C\xB72\uB3C4\uD06C\uC5D0 \uAC01 900t \uAC20\uD2B8\uB9AC 1\uAE30\uC529\uB9CC
    \uBA85\uC2DC\uB428. \uD06C\uAE30\uB294 \uBCF4\uB3C4\uB9C8\uB2E4 \uB2E4\uB984(\uB192\uC774
    100m \uC774\uC0C1\xB7\uD3ED 150m \uC774\uC0C1 / 2\uB3C4\uD06C \uC124\uCE58 \uB2F9\uC2DC
    \uD3ED 180m\xB7\uB192\uC774 90m).\n\uAD8C\uC0C1\uB192\uC774\uB294 \uC804\uCCB4
    \uB192\uC774\uAC00 \uC544\uB2D8. \uC678\uD615 \uCE58\uC218\uB294 ESTIMATED."
  capacityTon: 900
  hasCapacity: 1
  isPublicValue: 1
  isEstimated: 1
  sourceRow: 2
