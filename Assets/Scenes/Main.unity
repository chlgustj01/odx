  facility: {fileID: 839120827}
  recordJson: "{\"id\":19,\"sourceRow\":20,\"facilityId\":\"F19\",\"name\":\"\uD574\uC591\uC81C\uC791
    3\uACF5\uC7A5\",\"officialName\":\"\uD574\uC591\uC81C\uC791 3\uACF5\uC7A5\",\"englishName\":\"Maritime
    Manufacturing Plant 3\",\"classification\":\"\uD574\uC591\uC81C\uC791\",\"type\":\"\uC0DD\uC0B0\uACF5\uC7A5\",\"description\":\"\uD574\uC591\uD50C\uB79C\uD2B8
    \uB300\uD615 \uBE14\uB85D\uC744 \uC870\uB9BD\uD558\uACE0 \uC774\uC5B4 \uBD99\uC5EC
    \uB354 \uD070 \uBE14\uB85D\uC73C\uB85C \uB9CC\uB4DC\uB294 \uB300\uC870\uB9BD
    \uACF5\uC7A5. \uB2E8\uC77C \uACF5\uC7A5\uC73C\uB85C\uB294 \uC57C\uB4DC\uC5D0\uC11C
    \uAC00\uC7A5 \uD06C\uB2E4.\",\"mainProcess\":\"\xB7 \uD574\uC591\uD50C\uB79C\uD2B8
    \uB300\uC870\uB9BD\\n\xB7 \uB300\uD615 \uBE14\uB85D \uC5F0\uACB0\",\"specifications\":\"\uAE38\uC774(m):
    210\\n\uD3ED(m): 54\",\"cranes\":\"\uCC9C\uC7A5\uD06C\uB808\uC778 250t\\n\uCC9C\uC7A5\uD06C\uB808\uC778
    50t\",\"equipment\":\"\xB7 \uB300\uC870\uB9BD\uC6A9 \uD540 \uC9C0\uADF8 \uC815\uBC18\\n\xB7
    \uB300\uD615 \uBE14\uB85D \uC870\uB9BD\uC6A9 \uACA9\uC790\uC815\uBC18\",\"notes\":null,\"confidence\":\"A\",\"source\":\"\uD55C\uD654\uC624\uC158
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C
    > Facilities\\nHanwha Ocean official site > Geoje shipyard > Facilities (English)\",\"imageFile\":\"19_offshore_fab3.png\",\"dimensionBasis\":\"WORKBOOK_PUBLIC_DATA\",\"locationBasis\":\"CURRENT_LAYOUT_RECONSTRUCTION\",\"lengthM\":210.0,\"widthM\":54.0,\"depthM\":null,\"areaM2\":null,\"quayLengthM\":null,\"function_value_status\":null,\"function_source\":null,\"dimension_value_status\":\"ESTIMATED\",\"dimension_status_note\":\"\uACF5\uC2DD
    \uC790\uB8CC\uB294 '\uC57C\uB4DC \uCD5C\uB300 \uB2E8\uC77C \uACF5\uC7A5 210\xD754m'\uB9CC
    \uAE30\uC7AC\uD558\uBA70, \uD574\uB2F9 \uACF5\uC7A5\uC774 F19\uB77C\uACE0 \uD2B9\uC815\uB418\uC9C0
    \uC54A\uC74C\",\"function_capabilities\":null,\"value_evidence\":[{\"key\":\"dimension\",\"label\":\"DIMENSION\",\"value\":\"210
    \xD7 54\",\"unit\":\"m\",\"value_status\":\"ESTIMATED\",\"source\":\"https://www.hanwhaocean.com/en/whoweare/ig/facilities/\",\"verified_date\":null,\"note\":\"\uACF5\uC2DD
    \uC790\uB8CC\uB294 '\uC57C\uB4DC \uCD5C\uB300 \uB2E8\uC77C \uACF5\uC7A5 210\xD754m'\uB9CC
