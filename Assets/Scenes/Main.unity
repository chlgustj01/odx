  recordJson: "{\"id\":11,\"sourceRow\":12,\"facilityId\":\"F11\",\"name\":\"\uC808\uB2E8\uACF5\uC7A5\",\"officialName\":\"\uC808\uB2E8\uACF5\uC7A5\",\"englishName\":\"Cutting
