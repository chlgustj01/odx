  facility: {fileID: 927710633}
  recordJson: "{\"id\":4,\"sourceRow\":5,\"facilityId\":\"F04\",\"name\":\"\uC5F0\uAD6C\uC18C\",\"officialName\":\"\uC5F0\uAD6C\uC18C\",\"englishName\":\"Research
    Institute\",\"classification\":\"\uC9C0\uC6D0\uC2DC\uC124\",\"type\":\"\uC5F0\uAD6C\uC2DC\uC124\",\"description\":\"\uC120\uBC15\xB7\uD574\uC591\uD50C\uB79C\uD2B8\uC758
    \uAC74\uC870\uC640 \uC6B4\uC601\uC5D0 \uD544\uC694\uD55C \uAE30\uBC18 \uAE30\uC220\uC744
    \uC5F0\uAD6C\uD558\uB294 \uACF3. \uC124\uACC4\xB7\uC6A9\uC811\uAE30\uC220, \uC790\uB3D9\uD654
    \uACF5\uC815\uACFC \uC124\uBE44 \uBC30\uCE58, \uC131\uB2A5\uD574\uC11D\uACFC
    \uC2DC\uBBAC\uB808\uC774\uC158, \uB3C4\uB8CC \uAC1C\uBC1C, \uCE5C\uD658\uACBD\xB7\uC5D0\uB108\uC9C0
    \uC800\uAC10 \uC5F0\uAD6C\uB97C \uC218\uD589\uD55C\uB2E4.\",\"mainProcess\":\"\xB7
    \uC124\uACC4\xB7\uC6A9\uC811\uAE30\uC220 \uC5F0\uAD6C\\n\xB7 \uC790\uB3D9\uD654
    \uACF5\uC815\xB7\uC124\uBE44 layout \uC5F0\uAD6C\\n\xB7 \uC131\uB2A5\uD574\uC11D\xB7\uC2DC\uBBAC\uB808\uC774\uC158\\n\xB7
    \uB3C4\uB8CC \uAC1C\uBC1C\xB7\uBB3C\uC131 \uD3C9\uAC00\\n\xB7 \uCE5C\uD658\uACBD\xB7\uC5D0\uB108\uC9C0
    \uC800\uAC10 \uC5F0\uAD6C\",\"specifications\":null,\"cranes\":null,\"equipment\":\"\xB7
    (\uAC70\uC81C\uC0AC\uC5C5\uC7A5 R&D \uC124\uBE44) \uC9C0\uB2A5\uD615 \uC0DD\uC0B0\uAE30\uC220
    \uC5F0\uAD6C\uC13C\uD130\\n\xB7 \uC2AC\uB85C\uC2F1 \uC5F0\uAD6C\uC13C\uD130\\n\xB7
    HILS \uC13C\uD130\\n\xB7 \uC2A4\uB9C8\uD2B8\uC57C\uB4DC \uC2E4\uC99D\uC13C\uD130\\n\xB7
    \uC5D0\uB108\uC9C0\uC2DC\uC2A4\uD15C \uC5F0\uAD6C\uC13C\uD130(LNG \uADF9\uC800\uC628
    \uC2E4\uD5D8)\",\"notes\":\"\xB7 R&D \uC124\uBE44 5\uACF3\uC740 \uACF5\uC2DD
    R&D \uD398\uC774\uC9C0\uC5D0 '\uAC70\uC81C\uC0AC\uC5C5\uC7A5' \uC18C\uC7AC\uB85C\uB9CC
    \uB098\uC640 \uC788\uACE0, \uC774 \uC5F0\uAD6C\uC18C \uAC74\uBB3C \uC548\uC5D0
    \uC788\uB294\uC9C0\uB294 \uD655\uC778\uB418\uC9C0 \uC54A\uC74C.\",\"confidence\":\"A\",\"source\":\"\uD55C\uD654\uC624\uC158
