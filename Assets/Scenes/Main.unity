    \uC911\uB300\uD615 \uC120\uBC15\uC758 \uAC74\uC870, \uC7AC\uC9C4\uC218, \uC218\uB9AC\uC5D0
    \uC4F0\uC778\uB2E4.\",\"mainProcess\":\"\xB7 \uD574\uC0C1 \uBE14\uB85D \uD0D1\uC7AC\xB7\uAC74\uC870\\n\xB7
    \uC9C4\uC218\xB7\uC7AC\uC9C4\uC218\\n\xB7 \uC120\uBC15 \uC218\uB9AC\",\"specifications\":\"\uBCF4\uC720\uC218:
    3\\n\uCD5C\uB300\uC9C4\uC218: \uC218\uC5D0\uC988\uB9C9\uC2A4\uAE09\",\"cranes\":null,\"equipment\":null,\"notes\":\"\xB7
    \uBCF4\uC720\uC218 3\uAE30\xB7\uC81C\uC6D0\uC740 LR(\uC81C3\uC790) \uBC0F 2022\uB144
    \uBCF4\uB3C4 \uAE30\uC900. \uACF5\uC2DD \uD398\uC774\uC9C0\uC5D0\uB294 \uAE30\uC218\xB7\uC81C\uC6D0\uC774
    \uC5C6\uC74C.\\n\xB7 \uC601\uBB38 \uACF5\uC2DD \uD398\uC774\uC9C0\uB294 7\uB9CC8\uCC9C\uD1A4\uAE09
    LNG\uC120 \uC7AC\uC9C4\uC218\xB7\uC218\uB9AC\uAC00 \uAC00\uB2A5\uD558\uB2E4\uACE0
    \uD568.\",\"confidence\":\"B\",\"source\":\"\uD55C\uD654\uC624\uC158 \uACF5\uC2DD
    \uD648\uD398\uC774\uC9C0 > \uAC70\uC81C\uC0AC\uC5C5\uC7A5 \uC18C\uAC1C > Facilities\\nHanwha
    Ocean official site > Geoje shipyard > Facilities (English)\\nLloyd's Register
    New Construction Guide - Hanwha Ocean Co Ltd (2026-06-08 \uAC31\uC2E0)\\n\uC774\uB370\uC77C\uB9AC
    \uB974\uD3EC - \uB300\uC6B0\uC870\uC120\uD574\uC591 \uC625\uD3EC\uC870\uC120\uC18C
    (2022)\\n\uACBD\uB0A8\uB3C4\uBBFC\uC77C\uBCF4 - \uD55C\uD654\uC624\uC158 \uC625\uD3EC\uD56D
    \uBD80\uC720\uC2DD \uB3C5 \uC99D\uC124 (2026.10.19)\\n\uACBD\uD5A5\uC2E0\uBB38
    - \uD55C\uD654\uC624\uC158 \uD558\uCCAD\uB178\uB3D9\uC790 \uCD94\uB77D\uC0AC
    (2024.09.10)\",\"imageFile\":\"14_floating_dock.png\",\"dimensionBasis\":\"UNKNOWN\",\"locationBasis\":\"CURRENT_LAYOUT_RECONSTRUCTION\",\"lengthM\":null,\"widthM\":null,\"depthM\":null,\"areaM2\":null,\"quayLengthM\":null,\"function_value_status\":\"OFFICIAL\",\"function_source\":\"\uD55C\uD654\uC624\uC158
