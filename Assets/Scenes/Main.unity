  recordJson: "{\"id\":8,\"sourceRow\":9,\"facilityId\":\"F08\",\"name\":\"\uB9D1\uC740\uBB3C\uAD00\uB9AC\uC13C\uD130\",\"officialName\":\"\uB9D1\uC740\uBB3C\uAD00\uB9AC\uC13C\uD130\",\"englishName\":\"Clear
    Water Management Center\",\"classification\":\"\uC9C0\uC6D0\uC2DC\uC124\",\"type\":\"\uD658\uACBD\uC2DC\uC124\",\"description\":\"\uC870\uC120\uC18C
